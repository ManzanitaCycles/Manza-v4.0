<form id="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="heybear" action="/thanks/contact/">
	<input type="hidden" name="form-name" value="contact" />
	<input type="text" name="heybear" tabindex="-1" autocomplete="off" hidden />
	<label for="name">Name</label>
	<input id="name" type="text" name="name" required autocomplete="name" />
	<label for="email" class="mt-lg">Email</label>
	<input id="email" type="email" name="email" required autocomplete="email" />
	<label for="message" class="mt-lg">Message</label>
	<textarea id="message" name="message" required></textarea>
	<button type="submit" class="btn mt-lg">Send message</button>
</form>
