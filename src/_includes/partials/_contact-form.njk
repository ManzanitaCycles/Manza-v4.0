<form id="contact-form" class="stack box p-s-m contact-form" action="https://usebasin.com/f/319261c18814" method="POST">
    <!-- Honeypot field -->
    <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off"/>
    <input type="hidden" name="formStart"/>
    <div class="m-top-0">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required autocomplete="name"/>
        <span class="error-message">Enter your name.</span>
    </div>
    <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email"/>
        <span class="error-message">Enter a valid email address.</span>
    </div>
    <div>
        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>
        <span class="error-message">Enter a message.</span>
    </div>
    <button type="submit" class="button">Send</button>
</form>
<dialog id="contact-modal" class="modal stack box p-s-m">
    {% include "partials/_close-btn.njk" %}
    <p>✅ <strong>Message sent.</strong></p>
</dialog>