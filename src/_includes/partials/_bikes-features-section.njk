<section class="stack-2xl-5xl">
    {% for feature in features %}
    <div class="sidebar">
        {% image feature.image, feature.alt, "(min-width: 1560px) 911px, (min-width: 1000px) calc(85vw - 398px), calc(97.21vw - 24px)" %}
        <div class="stack">
            <h2>{{ feature.title }}</h2>
            <p class="muted m-top-0">{{ feature.desc }}</p>
        </div>
    </div>
    {% endfor %}
</section>