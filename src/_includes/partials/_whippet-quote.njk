<section class="center flow-thru">
	{% set quote = quotes | findByKey('name', 'John Watson - The Radavist') %} {% if quote %}
	<figure>
		<img src="{{ quote.img }}" alt="{{ quote.alt }}" />
	</figure>
	<blockquote class="highlight">
		<p>&ldquo;{{ quote.text }}&rdquo;</p>
		<footer>
			<cite>{{ quote.name }}</cite>
		</footer>
	</blockquote>
	{% endif %}
</section>
