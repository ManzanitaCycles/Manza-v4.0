<section class="center feature overline">
	<h2>Whippet results</h2>
	<div class="switcher mt-lg">
		{% for rider in results %}
		<figure>
			<img src="{{ rider.img }}" alt="{{ rider.alt }}" sizes="(min-width: 1060px) 304px, (min-width: 580px) 29.78vw, calc(100vw - 32px)" />
			<figcaption>
				<h3 class="mt-base">{{ rider.name }}</h3>
				<ul class="mt-sm stack" role="list">
					{% for result in rider.results %}
					<li>
						<p>
							<strong>{{ result.place }}</strong>
						</p>
						<p class="fine-print mt-0">{{ result.race }}</p>
					</li>
					{% endfor %}
				</ul>
			</figcaption>
		</figure>
		{% endfor %}
	</div>
</section>
