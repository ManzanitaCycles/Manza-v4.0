<form id="frameFitCalc" class="box__content stack">
	<div class="stack-xs">
		<label class="fine-print" for="user_handlebar_stack">Enter your handlebar stack (mm)</label>
		<input type="number" id="user_handlebar_stack" placeholder="e.g. 690" />
		<p class="error-message" hidden>{% include "partials/_warning-icon.njk" %} Enter a number between 540 and 775.</p>
	</div>
	<div class="stack-xs">
		<label class="fine-print" for="user_handlebar_reach">Enter your handlebar reach (mm)</label>
		<input type="number" id="user_handlebar_reach" placeholder="e.g. 465" />
		<p class="error-message" hidden>{% include "partials/_warning-icon.njk" %} Enter a number between 375 and 520.</p>
	</div>
	<div class="calc__buttons">
		<button type="submit" class="button">Calculate</button>
		<button type="button" class="button button--clear">Clear</button>
	</div>
</form>
<dialog id="frameFitCalc__modal" class="modal stack">
	<header class="modal__header">
		<h3 class="inline-block">Results</h3>
		{% include "partials/_close-btn.njk" %}
	</header>
	<div class="modal__card stack">
		<h3>Best match</h3>
		<dl>
			<dt>Frame size</dt>
			<dd id="best-frame-size"></dd>
			<dt>Stem length</dt>
			<dd id="best-stem-length"></dd>
			<dt>Stem angle</dt>
			<dd id="best-stem-angle"></dd>
			<dt>Spacer stack</dt>
			<dd id="best-spacer-stack"></dd>
		</dl>
	</div>
	<div class="modal__card stack">
		<h3>Best match with negative stem</h3>
		<dl>
			<dt>Frame size</dt>
			<dd id="neg-stem-frame-size"></dd>
			<dt>Stem length</dt>
			<dd id="neg-stem-length"></dd>
			<dt>Stem angle</dt>
			<dd id="neg-stem-angle"></dd>
			<dt>Spacer stack</dt>
			<dd id="neg-stem-spacer-stack"></dd>
		</dl>
	</div>
</dialog>
